# Base de dados — produção usa PostgreSQL/Supabase.
# No Render, usa o Session pooler do Supabase (porta 5432) e uma role dedicada
# ao backend. Nunca coloques a password no repositório.
DATABASE_URL=

# Backblaze B2 — armazenamento de fotos, vídeos e imagens de perfil/capa.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=pensador-sem-fronteiras-media
B2_REGION=us-east-005
# Prefixo opcional quando a Application Key estiver limitada a uma pasta.
B2_MEDIA_PREFIX=

# Chave para assinar o cookie de sessão (login).
SESSION_SECRET_KEY=
SESSION_COOKIE_SECURE=false

# Limite diário de anúncios por utilizador para reduzir spam e abuso.
MAX_POSTS_PER_USER_PER_DAY=10

# O email que se registar com este endereço fica automaticamente admin.
ADMIN_EMAIL=
