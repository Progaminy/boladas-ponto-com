# Backblaze B2 — https://secure.backblaze.com/app_keys.htm
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=pensador-sem-fronteiras-media
B2_REGION=us-east-005

# Provedor de IA: "auto" tenta o Vertex primeiro e usa o GMICloud como
# fallback. Também aceita "vertex" ou "gmicloud" para forçar um deles.
AI_PROVIDER=auto

# Gemini via Vertex AI Express — https://console.cloud.google.com/
# (modo Express: basta a chave API, sem projeto/região)
VERTEX_EXPRESS_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_CHAT_MODEL=gemini-2.5-flash

# GMICloud (fallback) — https://console.gmicloud.ai/
GMI_API_KEY=

# Modelos GMICloud usados (podem ser trocados sem alterar código)
GMI_IMAGE_MODEL=seedream-5.0-lite
GMI_CHAT_MODEL=deepseek-ai/DeepSeek-V3-0324

# Chave para assinar o cookie de sessão (login) — gera uma aleatória em produção:
#   python3 -c "import os; print(os.urandom(32).hex())"
SESSION_SECRET_KEY=

# Máximo de posts que um utilizador pode gerar por dia (protege os créditos do GMICloud)
MAX_POSTS_PER_USER_PER_DAY=10

# O email que se registar com este endereço fica automaticamente admin
# (acesso a /admin/moderacao para rever conteúdo reportado)
ADMIN_EMAIL=
