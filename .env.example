# Base de dados — produção usa PostgreSQL/Supabase.
DATABASE_URL=
SUPABASE_POOLER_HOST=aws-1-eu-west-1.pooler.supabase.com

# Backblaze B2 — apenas ficheiros reais enviados pelos utilizadores.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=pensador-sem-fronteiras-media
B2_REGION=us-east-005
B2_MEDIA_PREFIX=

SESSION_SECRET_KEY=
SESSION_COOKIE_SECURE=false
MAX_POSTS_PER_USER_PER_DAY=10
ADMIN_EMAIL=
